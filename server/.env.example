PORT=4000
# where the web app runs, for CORS
WEB_ORIGIN=http://localhost:3000
# secrets live here and only here, never in web/
# feedback reports (Claude). optional overrides below
ANTHROPIC_API_KEY=
# FEEDBACK_MODEL=claude-opus-5-5
# FEEDBACK_EFFORT=high
# voice interviewer. the browser only ever gets short-lived tokens minted from this
OPENAI_API_KEY=
# optional overrides, defaults live in src/env.ts
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# code execution (Judge0). the default public instance needs no key but is slow and shared.
# JUDGE0_URL=https://ce.judge0.com
# hosted on RapidAPI:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_KEY=
# self-hosted:
# JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
# if your instance numbers languages differently (see GET /languages):
# JUDGE0_LANGUAGE_IDS={"python":100,"javascript":102,"java":91,"cpp":105}
# limits per test case
# RUN_CPU_TIME_SEC=5
# RUN_MEMORY_MB=256
